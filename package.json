{
  "name": "astro-volga-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный сайт Астро-Волга с личными кабинетами агентов",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/migrate.js",
    "agent:create": "node server/create-agent.js",
    "agent:disable": "node server/disable-agent.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  }
}
